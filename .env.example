# ParserX environment variables
# Copy to .env and fill in your values.

# ── LLM / VLM services ────────────────────────────────────────────────
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
LLM_MODEL=gpt-5.4-mini
VLM_MODEL=gpt-5.4-mini

# parserx.yaml reads the *_B set by default (official OpenAI endpoint).
OPENAI_BASE_URL_B=https://api.openai.com/v1
OPENAI_API_KEY_B=
LLM_MODEL_B=gpt-6-luna
VLM_MODEL_B=gpt-6-luna

# ── PaddleOCR service (AI Studio async jobs API) ──────────────────────
# Token: https://aistudio.baidu.com/paddleocr → API
PADDLE_OCR_ENDPOINT=https://paddleocr.aistudio-app.com/api/v2/ocr/jobs
PADDLE_OCR_TOKEN=
# PADDLE_OCR_MODEL=PaddleOCR-VL-1.6
